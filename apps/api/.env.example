NODE_ENV=development
PORT=3100

DB_HOST=localhost
DB_PORT=5432
DB_NAME=petvio
DB_USER=petvio_user
DB_PASSWORD=your_secure_password_here

JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# URL aplikacji (linki w mailach)
APP_URL=https://petvio.pl

# Resend — powiadomienia email (zaproszenia do współdzielenia itp.)
# Klucz z https://resend.com/api-keys; domena petvio.pl musi być zweryfikowana w Resend (DNS).
# Bez klucza maile są pomijane (log "[email] pomijam wysyłkę").
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Petvio.pl <powiadomienia@petvio.pl>

# Firebase Cloud Messaging (powiadomienia push)
# Opcja A: pełny JSON konta serwisowego jedną linią:
FIREBASE_SERVICE_ACCOUNT_JSON=
# Opcja B: ścieżka do pliku JSON konta serwisowego:
FIREBASE_SERVICE_ACCOUNT_PATH=

# RevenueCat (IAP iOS)
REVENUECAT_WEBHOOK_SECRET=
