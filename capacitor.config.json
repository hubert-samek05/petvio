{
	"appId": "pl.petvio.mobile",
	"appName": "Petvio",
	"webDir": "public",
	"server": {
		"url": "https://petvio.pl/dashboard",
		"androidScheme": "https",
		"allowNavigation": ["petvio.pl", "*.petvio.pl"]
	},
	"android": {
		"includePlugins": [
			"@capacitor-community/background-geolocation",
			"@capacitor-firebase/authentication",
			"@capacitor-firebase/messaging",
			"@capacitor/geolocation",
			"@capacitor/local-notifications"
		]
	},
	"plugins": {
		"FirebaseAuthentication": {
			"skipNativeAuth": true,
			"providers": ["apple.com"]
		}
	}
}
